<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PocoToolkit.App.ViewModels"
    x:Class="PocoToolkit.App.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d"
    Width="900"
    Height="600"
    Title="POCO Toolkit">

    <StackPanel
        Margin="25"
        Spacing="12">

        <TextBlock
            FontSize="28"
            FontWeight="Bold"
            Text="POCO Toolkit"/>

        <Separator/>

        <TextBlock
            FontSize="22"
            FontWeight="Bold"
            Text="ADB Status"/>

        <TextBlock
            FontSize="18"
            Text="{Binding AdbStatus}"/>

        <TextBlock
            FontSize="15"
            Text="{Binding AdbVersion}"/>

        <TextBlock
            FontSize="15"
            Text="{Binding AdbPath}"/>

        <Separator/>

        <TextBlock
            FontSize="22"
            FontWeight="Bold"
            Text="Android Device"/>

        <TextBlock
            FontSize="18"
            Text="{Binding DeviceStatus}"/>

    </StackPanel>

</Window>